{
  "name": "comprsly",
  "main": "src/index.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "routes": [
    { "pattern": "comprsly.com", "custom_domain": true },
    { "pattern": "www.comprsly.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../frontend/public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "comprsly-analytics",
      "database_id": "81759501-0d69-414f-9b6f-f80ff328f289"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
