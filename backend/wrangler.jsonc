{
  "name": "comprsly",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "routes": [
    { "pattern": "comprsly.com", "custom_domain": true },
    { "pattern": "www.comprsly.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    // Deliberately `true`, not a path list. Every response, static assets
    // included, has to pass through src/index.js so the security headers get
    // applied. Narrowing this to an array would let asset requests bypass the
    // Worker and silently drop those headers, which is exactly the bug that
    // cost a day back on 2026-07-27 before this flag was added.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "comprsly-analytics",
      "database_id": "81759501-0d69-414f-9b6f-f80ff328f289"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
