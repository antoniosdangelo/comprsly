{
  "manifest_version": 3,
  "name": "Token Saver (dev build)",
  "version": "0.1.0",
  "description": "Watches AI chat sites and suggests shorter prompts to save tokens, fully local, nothing ever leaves your browser.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["suggestions.js", "suggestion-card.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
