<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for the signed build. Unused until the Apple Developer account
  exists; the workflow skips signing without it.

  NOT sandboxed, on purpose. The App Sandbox forbids reading another
  application's accessibility tree, which is the entire product. A sandboxed
  Comprsly could not see a single chat box. That also rules out the Mac App
  Store, which requires the sandbox, so this is a direct download app and the
  decision is structural rather than a preference.

  The two JIT/unsigned-memory entitlements are for onnxruntime, which the
  hardened runtime otherwise blocks when it generates code at run time.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
