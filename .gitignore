# Comprsly root .gitignore. Code and documents go in, secrets and rebuildable bulk stay out.

# Secrets, never commit
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key
*.pfx
*credentials*

# Rebuildable bulk
node_modules/
__pycache__/
*.pyc
.wrangler/
product/build/build/
product/build/dist/
product/build/installer-output/

# Large media and packages
*.mp4
*.mov
*.zip
*.msix
*.exe

# Local tool state and OS junk
.claude/
*.log
@AutomationLog.txt
Thumbs.db
desktop.ini
.DS_Store

# Vite build output, rebuilt by `npm run build` on every deploy

# Local git worktrees
.worktrees/

# Playwright run artifacts (baselines in test/__screenshots__ ARE committed)
frontend/test-results/
frontend/playwright-report/

# Surface probe output (local diagnostic, not a deliverable)
product/tools/probe-surfaces.jsonl

# Relative-path build used only for artifact previews

# Handover notes written per branch for review, never committed
PR.md
*/PR.md
**/PR.md

# Working notes for Antonio, deliberately untracked
docs/REPO_AND_CLOUDFLARE_MAP.md
