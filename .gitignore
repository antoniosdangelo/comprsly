# Comprsly root .gitignore. Code and documents go in, secrets and rebuildable bulk stay out.

# Secrets, never commit
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key
*.pfx
*credentials*

# Rebuildable bulk
node_modules/
__pycache__/
*.pyc
.wrangler/
desktop/build/
desktop/dist/
desktop/installer-output/

# Large media and packages
*.mp4
*.mov
*.zip
*.msix
*.exe

# Local tool state and OS junk
.claude/
*.log
@AutomationLog.txt
Thumbs.db
desktop.ini
.DS_Store

# Vite build output, rebuilt by `npm run build` on every deploy
frontend/dist/

# Local git worktrees
.worktrees/

# Playwright run artifacts (baselines in test/__screenshots__ ARE committed)
frontend/test-results/
frontend/playwright-report/
