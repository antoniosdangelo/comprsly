{
  "name": "comprsly-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "comprsly.com pages: Vite + React + TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "test": "tsc -b && oxlint",
    "test:parity": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
